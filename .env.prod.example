# Окружение прода. Копируется на сервер в /opt/lexi-bot/.env с правами 600
# и в git не попадает — здесь только образец.
#
#   install -m 600 /dev/null /opt/lexi-bot/.env && nano /opt/lexi-bot/.env
#
# Файл читают двое: docker compose (подставляет значения в compose-файл)
# и сам бот (через env_file). Поэтому кавычек вокруг значений быть не должно —
# compose возьмёт их как часть строки.

# Токен прод-бота от @BotFather. Обязательно ОТДЕЛЬНЫЙ от того, с которым
# работает разработка: два процесса с одним токеном получают от Telegram
# 409 Conflict и теряют сообщения (DEPLOY.md §6).
BOT_TOKEN=

# Пароль базы. Наружу порт Postgres не публикуется, но пароль всё равно
# должен быть случайным: он же уезжает в строку подключения и в дампы.
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Чат для тревог: паника, сорванная миграция, серия ошибок Bot API, провал
# бэкапа. Узнать идентификатор: написать боту и открыть
#   https://api.telegram.org/bot<ТОКЕН>/getUpdates
# У группы идентификатор отрицательный — это нормально.
# Пусто — тревоги выключены, и о поломке вы узнаете от пользователей.
ADMIN_CHAT_ID=

# Какой образ запущен. latest — то, что собрал последний зелёный main;
# sha-<полный SHA коммита> — конкретная версия. Откат релиза это правка
# одной этой строки и `docker compose -f docker-compose.prod.yml up -d bot`.
IMAGE_TAG=latest

# Часовой пояс для тех, кто ещё не выбрал свой: по нему считаются учебные
# сутки и время напоминаний. Имя IANA.
DEFAULT_TIMEZONE=UTC

# debug | info | warn | error. В проде info: debug пишет по строке на каждый
# апдейт и за неделю съедает ротацию логов.
LOG_LEVEL=info
