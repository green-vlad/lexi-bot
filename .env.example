# Скопируйте в .env и заполните BOT_TOKEN. Файл .env в git не попадает.

# dev | prod. В dev логи текстовые, в prod — JSON.
APP_ENV=dev

# Токен от @BotFather. Для разработки заведите ОТДЕЛЬНОГО бота: два процесса
# с одним токеном получают от Telegram 409 Conflict и теряют сообщения.
BOT_TOKEN=

# Строка подключения к базе разработки (поднимается через `task up`).
DATABASE_URL=postgres://lexi:lexi@localhost:5432/lexi?sslmode=disable

# Отдельная база для интеграционных тестов. Если переменная не задана,
# тесты сами поднимут контейнер через testcontainers.
TEST_DATABASE_URL=postgres://lexi:lexi@localhost:5432/lexi_test?sslmode=disable

# debug | info | warn | error
LOG_LEVEL=debug

# Адрес для /healthz и /metrics. Наружу не публикуется.
HTTP_ADDR=127.0.0.1:8080

# Часовой пояс по умолчанию для пользователей, которые ещё не выбрали свой (IANA).
DEFAULT_TIMEZONE=UTC

# Чат для алертов (паники, ошибки миграций, провал бэкапа). Пусто — алерты выключены.
ADMIN_CHAT_ID=
