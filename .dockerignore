# Всё, что не участвует в сборке, до демона не доезжает: контекст меньше —
# сборка быстрее, а секрет, которого нет в контексте, невозможно вшить в слой.

# Секреты и локальные настройки.
.env
.env.*
!.env.example

# История и служебные каталоги.
.git
.gitignore
.github
.idea
.vscode
.claude

# Результаты локальных сборок и прогонов.
bin/
coverage.out
*.test

# Документация и окружение разработки: на бинарник не влияют.
docs/
README.md
Taskfile.yml
docker-compose.yml
docker/
.golangci.yml
Dockerfile
.dockerignore
